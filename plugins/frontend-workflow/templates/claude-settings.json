{
  "$comment": "Copy to <project>/.claude/settings.json and commit it. Teammates who trust the project get the plugin automatically.",
  "extraKnownMarketplaces": {
    "mohamed-frontend": {
      "source": { "source": "github", "repo": "mitchdesigns-com/frontend-workflow" }
    }
  },
  "enabledPlugins": {
    "frontend-workflow@mohamed-frontend": true
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)"
    ],
    "allow": [
      "Read(./.env.example)"
    ]
  }
}
